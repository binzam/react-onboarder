{
  "name": "@binii/react-onboarder",
  "version": "0.1.0",
  "description": "Fluid, type-safe product tours for React and Next.js. Tailwind-styled, Framer Motion animated, Floating UI positioned.",
  "license": "MIT",
  "author": "Binii",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "target": [
        "./dist/target.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./target": {
      "import": {
        "types": "./dist/target.d.ts",
        "default": "./dist/target.js"
      },
      "require": {
        "types": "./dist/target.d.cts",
        "default": "./dist/target.cjs"
      }
    },
    "./tailwind.css": "./tailwind.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tailwind.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build && pnpm check:package"
  },
  "keywords": [
    "react",
    "nextjs",
    "onboarding",
    "tour",
    "guided-tour",
    "product-tour",
    "walkthrough",
    "spotlight",
    "tailwindcss",
    "framer-motion",
    "floating-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binzam/react-onboarder.git"
  },
  "bugs": {
    "url": "https://github.com/binzam/react-onboarder/issues"
  },
  "homepage": "https://github.com/binzam/react-onboarder#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.8.1",
  "peerDependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "framer-motion": "^13.4.6",
    "jsdom": "^30.1.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
